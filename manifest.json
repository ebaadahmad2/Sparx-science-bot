{
  "manifest_version": 3,
  "name": "Sparx Science Bot",
  "version": "2.0.0",
  "description": "AI Sparx Science assistant. Password protected.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.sparxscience.com/*",
    "https://*.sparx-learning.com/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "content_scripts": [{
    "matches": [
      "https://*.sparxscience.com/*",
      "https://*.sparx-learning.com/*"
    ],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icons/icon128.png" }
}
